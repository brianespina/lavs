---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import NewsCard from "../components/NewsCard.astro";
import CortijoPanel from "../components/CortijoPanel.astro";
import { formatNewsDate } from "../lib/news";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const services = [
  { num: "01", href: "/lavs-trading/landscaping", title: "Landscaping", body: "Softscape and hardscape design, build, and installation.", svg: '<path d="M2 18h20M5 13h14M8 8h8"/>' },
  { num: "02", href: "/lavs-trading/farm-development", title: "Farm Development", body: "Site assessment, land clearing, soil work and planting.", svg: '<rect x="3" y="3" width="7.5" height="7.5"/><rect x="13.5" y="3" width="7.5" height="7.5"/><rect x="3" y="13.5" width="7.5" height="7.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5"/>' },
  { num: "03", href: "/lavs-trading/planting-materials-seedlings", title: "Planting Materials & Seedlings", body: "Grafted fruit trees, high-value seedlings, soil mixes and amendments.", svg: '<path d="M12 21V8M12 8c-4.5 0-7-3-7-3s2.5 6 7 6M12 12c4.5 0 7-3 7-3s-2.5 6-7 6"/>' },
  { num: "04", href: "/lavs-trading/bulk-agro-industrial-supplies", title: "Bulk Agro-Industrial Supplies", body: "Coco nets, charcoal briquettes, VCO oil and raw materials.", svg: '<path d="M5 20V9M12 20V4M19 20v-7"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="10" r="2"/>' },
];

const whoWeHelp = [
  { num: "01", title: "Local Farmers & Landowners", body: "We help landowners unlock the true potential of their properties — farm development, site preparation, and intricate hardscape landscaping by an invested, employee-owned team." },
  { num: "02", title: "Commercial & Residential Properties", body: "We transform outdoor environments into functional, beautiful, enduring spaces — combining structural strength with aesthetic design." },
  { num: "03", title: "Commercial & Industrial Clients", body: "Industrial-scale volumes of durable, eco-friendly materials — erosion-control geotextiles, coco nets, and activated carbon." },
  { num: "04", title: "Producers & Cooperatives", body: "We bridge local producers to broader markets — aggregating produce, supplying seedlings and inputs, and taking distribution off their hands." },
];

const accreditations = [
  { src: "/logos/tesda.png", alt: "TESDA" },
  { src: "/logos/da-ati.png", alt: "DA · ATI" },
  { src: "/logos/pca.png", alt: "PCA" },
  { src: "/logos/deped.png", alt: "DepEd" },
  { src: "/logos/dti.png", alt: "DTI" },
  { src: "/logos/sec.png", alt: "SEC" },
];

---

<BaseLayout title="Home">
  <div class="overflow-hidden bg-white">
    <SiteNav active="home" />

    <!-- Hero -->
    <div class="relative bg-forest">
      <div class="absolute inset-0">
        <video
          autoplay
          muted
          loop
          playsinline
          poster="/images/hero-still.jpg"
          aria-label="Aerial view of Philippine farmland and agricultural land development"
          class="h-full w-full object-cover"
        >
          <source src="/videos/hero-section-1900.webm" type="video/webm" />
        </video>
      </div>
      <div class="absolute inset-0 bg-forest opacity-[.62]"></div>
      <div class="band-x pointer-events-none relative flex min-h-[560px] flex-col justify-center gap-5 py-10 lg:min-h-[760px] lg:gap-[30px]">
        <div class="text-[10px] font-semibold uppercase tracking-[.2em] text-gold-light lg:text-[13px] lg:tracking-[.24em]">
          LAVS Trading &amp; Development Services Inc.
        </div>
        <div class="text-pretty text-[36px] font-semibold leading-[1.1] tracking-[-.025em] text-bone lg:max-w-[900px] lg:text-[66px] lg:leading-[1.06] lg:tracking-[-.025em]">
          Empowering Philippine land, commerce, and agriculture.
        </div>
        <div class="text-pretty text-[14.5px] leading-[1.6] text-mint lg:max-w-[660px] lg:text-lg">
          Connecting local producers, partner enterprises, and industrial markets with professional land development, sustainable trading solutions, and agricultural supply.
        </div>
        <div class="pointer-events-auto flex flex-col gap-[10px] pt-2 sm:flex-row sm:gap-4">
          <Button href="/lavs-trading" variant="gold" pad="px-7 py-[18px]">Explore LAVS Trading</Button>
        </div>
      </div>
    </div>

    <!-- Driving Philippine commerce, industrial supply, and agricultural trade -->
    <div class="band-x flex flex-col gap-10 bg-forest py-[56px] lg:gap-12 lg:py-[88px]">
      <!-- Header row: title left, description right -->
      <div class="flex flex-col gap-6 lg:flex-row lg:items-start lg:justify-between lg:gap-14">
        <div class="flex flex-col gap-[22px] lg:max-w-[620px]">
          <SectionLabel text="One registered enterprise" color="text-sage" />
          <div class="text-pretty text-3xl font-semibold leading-[1.1] tracking-[-.03em] text-bone lg:text-[40px]">
            Driving Philippine commerce, industrial supply, and agricultural trade
          </div>
        </div>
        <div class="text-pretty text-[15.5px] leading-[1.7] text-mint lg:max-w-[380px]">
          LAVS Trading &amp; Development Services Inc. holds the group&rsquo;s trading registration &mdash; land development, industrial supply, and agricultural inputs under one accountable, employee-owned team.
        </div>
      </div>

      <!-- Second row: Where we focus, left; service tiles, right -->
      <div class="flex flex-col gap-10 lg:flex-row lg:items-start lg:gap-14">
        <div class="flex flex-col gap-[22px] lg:w-[420px] lg:flex-none">
          <div class="text-[13.5px] font-semibold tracking-[.02em] text-bone">Where we focus:</div>
          <div class="grid grid-cols-2 gap-7">
            <div class="flex flex-col gap-[11px]">
              <div class="text-[12.5px] font-semibold uppercase leading-[1.65] tracking-[.14em] text-gold-light">Commercial priorities</div>
              <div class="flex flex-col gap-[9px] text-[13.5px] leading-snug text-mint">
                <div>Hardscape strength &amp; durability</div>
                <div>Site preparation &amp; drainage</div>
                <div>Industrial-volume supply</div>
                <div>Eco-friendly materials</div>
              </div>
            </div>
            <div class="flex flex-col gap-[11px]">
              <div class="text-[12.5px] font-semibold uppercase leading-[1.65] tracking-[.14em] text-sage">Agricultural priorities</div>
              <div class="flex flex-col gap-[9px] text-[13.5px] leading-snug text-mint">
                <div>Market access for producers</div>
                <div>Seedlings &amp; input supply</div>
                <div>Produce aggregation</div>
                <div>Cooperative partnerships</div>
              </div>
            </div>
          </div>
          <div class="flex pt-[14px]">
            <Button href="/contact" variant="outline-sage" pad="px-6 py-[15px]">Talk to our team</Button>
          </div>
        </div>

        <div class="grid flex-1 grid-cols-1 gap-4 sm:grid-cols-2">
        {services.map((s) => (
          <a
            href={s.href}
            class="flex flex-col gap-[11px] rounded-tl-photo rounded-br-photo border border-forest-card-border bg-forest-card p-6 pb-[22px] hover:border-sage hover:bg-forest-card-hover transition-colors"
          >
            <div class="flex items-center justify-between gap-3">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke-width="1.5" class="flex-none stroke-sage" set:html={s.svg} />
              <div class="text-[11px] font-bold tracking-[.14em] text-gold-light">{s.num}</div>
            </div>
            <div class="text-pretty text-[19px] font-semibold leading-[1.25] tracking-[-.01em] text-bone">{s.title}</div>
            <div class="text-pretty text-[13.5px] leading-[1.55] text-pale-sage">{s.body}</div>
            <div class="mt-auto pt-3 text-[11px] font-semibold uppercase tracking-[.14em] text-mint">View &rarr;</div>
          </a>
        ))}
        </div>
      </div>
    </div>

    <!-- Who We Help -->
    <div class="band-x flex flex-col gap-12 bg-bone py-[56px] lg:flex-row lg:items-center lg:gap-16 lg:py-[88px]">
      <div class="flex flex-1 flex-col gap-[22px]">
        <SectionLabel text="Who we help" color="text-muted" />
        <div class="max-w-[520px] text-pretty text-[30px] font-semibold leading-[1.16] tracking-[-.025em] text-forest lg:text-[38px]">
          Driving Philippine commerce, industrial supply, and agricultural trade.
        </div>
        <div class="max-w-[480px] text-pretty text-[15px] leading-[1.65] text-body">
          We distribute high-volume agricultural inputs, certified seedlings, and bulk Philippine commodities directly to commercial and global markets.
        </div>
        <div class="flex pt-[14px]">
          <Button href="/contact" variant="outline-forest" pad="px-6 py-[15px]">Find your pathway</Button>
        </div>
      </div>
      <div class="flex flex-1 flex-col gap-[2px] bg-border-light lg:flex-[1.15]">
        {whoWeHelp.map((item) => (
          <div class="flex gap-[22px] bg-white p-6 lg:px-[30px] lg:py-7">
            <div class="flex-none pt-1 text-xs font-bold tracking-[.14em] text-gold">{item.num}</div>
            <div class="flex flex-col gap-[9px]">
              <div class="text-base font-semibold text-forest">{item.title}</div>
              <div class="text-pretty text-sm leading-[1.6] text-body">{item.body}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Sustainability & community: Cortijo introduction panel -->
    <div class="band-x flex flex-col gap-8 bg-bone-deep py-16 lg:gap-[38px] lg:py-[88px]">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between lg:gap-14">
        <div class="flex flex-col gap-4">
          <SectionLabel text="Sustainability & community" color="text-muted" size="sm" />
          <div class="max-w-[620px] text-pretty text-[28px] font-semibold leading-[1.16] tracking-[-.025em] text-forest lg:text-[38px]">
            Our advocacy and education work runs through Cortijo de Palsabangon.
          </div>
        </div>
        <div class="text-pretty text-[14.5px] leading-[1.65] text-muted-3 lg:max-w-[380px]">
          LAVS Trading holds the commercial side. Everything to do with teaching sits with Cortijo de Palsabangon Farm OPC &mdash; part of the group, with its own accreditations and its own name.
        </div>
      </div>

      <CortijoPanel image="/images/cortijo/panel-home.webp" imageAlt="Trainees with the day's harvest in the farm school's trellised plots" />
    </div>

    <!-- Accreditation strip -->
    <div class="band-x flex flex-col items-start gap-6 border-b border-border-light bg-white py-10 lg:flex-row lg:items-center lg:gap-12 lg:py-14">
      <div class="max-w-[170px] flex-none text-xs font-semibold uppercase leading-[1.5] tracking-[.2em] text-muted">
        Accredited &amp; aligned with
      </div>
      <div class="grid flex-1 grid-cols-3 gap-4 sm:grid-cols-6">
        {accreditations.map((item) => (
          <div class="flex h-[88px] items-center justify-center rounded-tl-chip rounded-br-chip bg-bone p-[14px]">
            {item.src ? (
              <img src={item.src} alt={item.alt} class="max-h-full max-w-full object-contain saturate-90" />
            ) : (
              <span class="text-[13px] font-semibold tracking-[.1em] text-body">{item.alt}</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- News & media -->
    <div class="band-x flex flex-col gap-12 bg-white py-16 lg:py-24">
      <div class="flex flex-col items-center gap-[14px] text-center">
        <SectionLabel text="News & media" color="text-muted" />
        <div class="text-[28px] font-semibold leading-[1.14] tracking-[-.025em] text-forest lg:text-[42px]">
          Latest news &amp; ecosystem updates
        </div>
      </div>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {latestNews.map((entry) => (
          <NewsCard
            image={entry.data.coverImage}
            imageAlt={entry.data.title}
            category={entry.data.category}
            date={formatNewsDate(entry.data.date)}
            title={entry.data.title}
            excerpt={entry.data.excerpt}
            href={`/news/${entry.id}`}
          />
        ))}
      </div>
      <div class="flex justify-center">
        <Button href="/news" variant="outline-forest" pad="px-[30px] py-4">View all news &amp; media</Button>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
