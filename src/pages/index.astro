---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import PathwayCard from "../components/PathwayCard.astro";
import NewsCard from "../components/NewsCard.astro";
import type { PathwayIcon } from "../components/PathwayCard.astro";
import { formatNewsDate } from "../lib/news";

const latestNews = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const lavsIcons: PathwayIcon[] = [
  { href: "/lavs-trading/landscaping", label: "Hardscape", svg: '<path d="M2 18h20M5 13h14M8 8h8"/>' },
  { href: "/lavs-trading/farm-development", label: "Farm", svg: '<rect x="3" y="3" width="7.5" height="7.5"/><rect x="13.5" y="3" width="7.5" height="7.5"/><rect x="3" y="13.5" width="7.5" height="7.5"/><rect x="13.5" y="13.5" width="7.5" height="7.5"/>' },
  { href: "/lavs-trading/coco-nets", label: "Nets", svg: '<path d="M3 3h18v18H3zM3 9h18M3 15h18M9 3v18M15 3v18"/>' },
  { href: "/lavs-trading/charcoal-briquettes", label: "Charcoal", svg: '<path d="M4 8h11a5 5 0 0 1 0 8H4zM4 8v8"/>' },
  { href: "/lavs-trading/vco-oil", label: "VCO Oil", svg: '<path d="M12 3c3.5 4 6 6.8 6 10a6 6 0 0 1-12 0c0-3.2 2.5-6 6-10z"/>' },
];

const cortijoIcons: PathwayIcon[] = [
  { href: "/cortijo", label: "Produce", svg: '<circle cx="12" cy="14" r="6"/><path d="M12 8c0-3 2-4 4-4"/>' },
  { href: "/cortijo", label: "Inputs", svg: '<path d="M5 20V9M12 20V4M19 20v-7"/><circle cx="5" cy="6" r="2"/><circle cx="19" cy="10" r="2"/>' },
  { href: "/cortijo", label: "Nursery", svg: '<path d="M4 20h16M8 20v-5M16 20v-9"/><path d="M8 15c-3 0-4-2-4-4 3 0 4 2 4 4zM16 11c3 0 4-2 4-4-3 0-4 2-4 4z"/>' },
  { href: "/cortijo", label: "TESDA", svg: '<path d="M3 8l9-4 9 4-9 4-9-4z"/><path d="M7 10v5c0 1.7 2.2 3 5 3s5-1.3 5-3v-5"/>' },
  { href: "/cortijo", label: "Certs", svg: '<circle cx="12" cy="9" r="5"/><path d="M9 14l-1.5 7L12 18l4.5 3L15 14"/>' },
];

const factRows = [
  { label: "Employee-owned", value: "Every project carries a personal stake" },
  { label: "Quezon Province", value: "Working farm and field operations" },
  { label: "DTI · SEC registered", value: "Formal, compliant, accountable" },
];

const whoWeHelp = [
  { num: "01", title: "Local Farmers & Landowners", body: "We help landowners unlock the true potential of their properties — farm development, site preparation, and intricate hardscape landscaping by an invested, employee-owned team." },
  { num: "02", title: "Commercial & Residential Properties", body: "We transform outdoor environments into functional, beautiful, enduring spaces — combining structural strength with aesthetic design." },
  { num: "03", title: "Commercial & Industrial Clients", body: "Industrial-scale volumes of durable, eco-friendly materials — erosion-control geotextiles, coco nets, and activated carbon." },
  { num: "04", title: "Producers, Cooperatives & Students", body: "We bridge local producers to broader markets, and equip aspiring farmers and students with certified, hands-on agricultural skills." },
];

const accreditations = [
  { src: "/logos/tesda.png", alt: "TESDA" },
  { src: "/logos/da-ati.png", alt: "DA · ATI" },
  { src: null, alt: "PCA" },
  { src: "/logos/deped.png", alt: "DepEd" },
  { src: "/logos/dti.png", alt: "DTI" },
  { src: "/logos/sec.png", alt: "SEC" },
];

---

<BaseLayout title="Home">
  <div class="overflow-hidden bg-white">
    <SiteNav active="home" />

    <!-- Hero -->
    <div class="relative h-[420px] bg-forest lg:h-[660px]">
      <div class="absolute inset-0">
        <img
          src="/images/hero-still.jpg"
          alt="Aerial view of Philippine farmland and agricultural land development"
          class="h-full w-full object-cover"
        />
      </div>
      <div class="absolute inset-0 bg-forest opacity-[.62]"></div>
      <div class="band-x pointer-events-none absolute inset-0 flex flex-col justify-center gap-5 py-10 lg:gap-[30px]">
        <div class="text-[10px] font-semibold uppercase tracking-[.2em] text-gold-light lg:text-[13px] lg:tracking-[.24em]">
          LAVS Trading &amp; Development Services Inc.
        </div>
        <div class="text-pretty text-[36px] font-semibold leading-[1.1] tracking-[-.025em] text-bone lg:max-w-[900px] lg:text-[66px] lg:leading-[1.06] lg:tracking-[-.025em]">
          Empowering Philippine land, commerce, and agriculture.
        </div>
        <div class="text-pretty text-[14.5px] leading-[1.6] text-mint lg:max-w-[660px] lg:text-lg">
          Connecting local producers, partner enterprises, and industrial markets with professional land development, sustainable trading solutions, and accredited agricultural training.
        </div>
        <div class="pointer-events-auto flex flex-col gap-[10px] pt-2 sm:flex-row sm:gap-4">
          <Button href="/lavs-trading" variant="gold" pad="px-7 py-[18px]">Explore LAVS Trading</Button>
          <Button href="/cortijo" variant="outline-bone" pad="px-7 py-[16.5px]" class="bg-bone/10">Explore Cortijo de Palsabangon</Button>
        </div>
      </div>
    </div>

    <!-- Choose your pathway -->
    <div class="band-x flex flex-col gap-10 bg-forest py-[56px] lg:flex-row lg:gap-14 lg:py-[88px]">
      <div class="flex flex-col gap-[22px] lg:w-[420px] lg:flex-none">
        <SectionLabel text="Two enterprises, one ecosystem" color="text-sage" />
        <div class="text-pretty text-3xl font-semibold leading-[1.1] tracking-[-.03em] text-bone lg:text-[40px]">
          Driving Philippine commerce, industrial supply, and agricultural trade
        </div>
        <div class="text-pretty text-[15.5px] leading-[1.7] text-mint">
          LAVS Trading &amp; Development Services Inc. works across our trusted partner network, powering an integrated ecosystem alongside Cortijo de Palsabangon Farm OPC.
        </div>
        <div class="pt-3 text-[13.5px] font-semibold tracking-[.02em] text-bone">Our focus across both enterprises:</div>
        <div class="grid grid-cols-2 gap-7">
          <div class="flex flex-col gap-[11px]">
            <div class="text-[12.5px] font-semibold uppercase leading-[1.65] tracking-[.14em] text-gold-light">Commercial priorities</div>
            <div class="flex flex-col gap-[9px] text-[13.5px] leading-snug text-mint">
              <div>Hardscape strength &amp; durability</div>
              <div>Site preparation &amp; drainage</div>
              <div>Industrial-volume supply</div>
              <div>Eco-friendly materials</div>
            </div>
          </div>
          <div class="flex flex-col gap-[11px]">
            <div class="text-[12.5px] font-semibold uppercase leading-[1.65] tracking-[.14em] text-sage">Agricultural priorities</div>
            <div class="flex flex-col gap-[9px] text-[13.5px] leading-snug text-mint">
              <div>Market access for producers</div>
              <div>National-standard certification</div>
              <div>Nursery &amp; input supply</div>
              <div>Community training</div>
            </div>
          </div>
        </div>
        <div class="flex pt-[14px] lg:mt-auto">
          <Button href="/contact" variant="outline-sage" pad="px-6 py-[15px]">Talk to our team</Button>
        </div>
      </div>

      <div class="grid flex-1 grid-cols-1 gap-6 lg:grid-cols-2">
        <PathwayCard
          brand="lavs"
          eyebrow="LAVS Trading & Development"
          title="Commercial trade, land development & industrial solutions"
          image="/images/pexels-marianna-zuzanna-498248397-16239801.jpg"
          imageAlt="Site development and hardscape landscaping"
          description="Professional landscaping and commercial site development, alongside the bulk distribution of primary Philippine commodities."
          ctaLabel="Explore LAVS Trading"
          ctaHref="/lavs-trading"
          icons={lavsIcons}
        />
        <PathwayCard
          brand="cortijo"
          eyebrow="Cortijo de Palsabangon Farm OPC"
          title="Agricultural solutions, training & community leadership"
          image="/images/pexels-th-tieu-707737703-33729068.jpg"
          imageAlt="Farm school training session"
          description="A DA-ATI Accredited Learning Site and TESDA Registered Farm School and Assessment Center, equipping farmers, students, and partners with national-standard competencies."
          ctaLabel="Explore Cortijo"
          ctaHref="/cortijo"
          icons={cortijoIcons}
        />
      </div>
    </div>

    <!-- Who We Help -->
    <div class="band-x flex flex-col gap-12 bg-bone py-[56px] lg:flex-row lg:items-center lg:gap-16 lg:py-[88px]">
      <div class="flex flex-1 flex-col gap-[22px]">
        <SectionLabel text="Who we help" color="text-muted" />
        <div class="max-w-[520px] text-pretty text-[30px] font-semibold leading-[1.16] tracking-[-.025em] text-forest lg:text-[38px]">
          Driving Philippine commerce, industrial supply, and agricultural trade.
        </div>
        <div class="max-w-[480px] text-pretty text-[15px] leading-[1.65] text-body">
          Across our trusted partner network, powering an integrated ecosystem alongside Cortijo de Palsabangon Farm OPC.
        </div>
        <div class="flex max-w-[480px] flex-col pt-[14px]">
          {factRows.map((row) => (
            <div class="flex items-baseline gap-4 border-t border-border-light-3 py-[15px]">
              <div class="w-[180px] flex-none text-[13.5px] font-semibold text-forest">{row.label}</div>
              <div class="text-[13.5px] leading-snug text-muted">{row.value}</div>
            </div>
          ))}
        </div>
        <div class="flex pt-3">
          <Button href="/contact" variant="outline-forest" pad="px-6 py-[15px]">Find your pathway</Button>
        </div>
      </div>
      <div class="flex flex-1 flex-col gap-[2px] bg-border-light lg:flex-[1.15]">
        {whoWeHelp.map((item) => (
          <div class="flex gap-[22px] bg-white p-6 lg:px-[30px] lg:py-7">
            <div class="flex-none pt-1 text-xs font-bold tracking-[.14em] text-gold">{item.num}</div>
            <div class="flex flex-col gap-[9px]">
              <div class="text-base font-semibold text-forest">{item.title}</div>
              <div class="text-pretty text-sm leading-[1.6] text-body">{item.body}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Sustainability -->
    <div class="band-x flex flex-col gap-10 bg-sand py-16 lg:flex-row lg:items-center lg:gap-14 lg:py-20">
      <div class="relative h-[240px] flex-1 overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[360px]">
        <img src="/images/pexels-denniz-futalan-339724-29928489.jpg" alt="Sustainability and community program" class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="flex flex-1 flex-col gap-6">
        <SectionLabel text="Sustainability & community" color="text-clay" />
        <div class="text-pretty text-[30px] font-semibold leading-[1.16] tracking-[-.025em] text-forest lg:text-[38px]">
          Building a greener future
        </div>
        <div class="text-pretty text-[15.5px] leading-[1.68] text-clay-deep">
          Sustainability is not just an initiative &mdash; it is the foundation of everything we do. True commercial growth, land development, and agriculture must go hand-in-hand with environmental stewardship and community empowerment.
        </div>
        <div class="flex flex-col gap-[14px] pt-1">
          <div class="flex items-start gap-[14px]">
            <div class="mt-[6px] h-[9px] w-[9px] flex-none bg-forest"></div>
            <div class="text-pretty text-[14.5px] leading-[1.6] text-clay-darker">
              <strong class="font-semibold text-forest">Eco-friendly commercial solutions</strong> &mdash; sustainable, nature-based Philippine byproducts that give industries practical tools to protect natural landscapes.
            </div>
          </div>
          <div class="flex items-start gap-[14px]">
            <div class="mt-[6px] h-[9px] w-[9px] flex-none bg-olive"></div>
            <div class="text-pretty text-[14.5px] leading-[1.6] text-clay-darker">
              <strong class="font-semibold text-forest">Community agriculture programs</strong> &mdash; uplifting local producers and training the next generation of growers.
            </div>
          </div>
          <div class="flex items-start gap-[14px]">
            <div class="mt-[6px] h-[9px] w-[9px] flex-none bg-gold"></div>
            <div class="text-pretty text-[14.5px] leading-[1.6] text-clay-darker">
              <strong class="font-semibold text-forest">Institutional alignment</strong> &mdash; standards and programs aligned with DA, DA-ATI, PCA, TESDA, DepEd, and DTI.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Accreditation strip -->
    <div class="band-x flex flex-col items-start gap-6 border-b border-border-light bg-white py-10 lg:flex-row lg:items-center lg:gap-12 lg:py-14">
      <div class="max-w-[170px] flex-none text-xs font-semibold uppercase leading-[1.5] tracking-[.2em] text-muted">
        Accredited &amp; aligned with
      </div>
      <div class="grid flex-1 grid-cols-3 gap-4 sm:grid-cols-6">
        {accreditations.map((item) => (
          <div class="flex h-[88px] items-center justify-center rounded-tl-chip rounded-br-chip bg-bone p-[14px]">
            {item.src ? (
              <img src={item.src} alt={item.alt} class="max-h-full max-w-full object-contain saturate-90" />
            ) : (
              <span class="text-[13px] font-semibold tracking-[.1em] text-body">{item.alt}</span>
            )}
          </div>
        ))}
      </div>
    </div>

    <!-- News & media -->
    <div class="band-x flex flex-col gap-12 bg-white py-16 lg:py-24">
      <div class="flex flex-col items-center gap-[14px] text-center">
        <SectionLabel text="News & media" color="text-muted" />
        <div class="text-[28px] font-semibold leading-[1.14] tracking-[-.025em] text-forest lg:text-[42px]">
          Latest news &amp; ecosystem updates
        </div>
      </div>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {latestNews.map((entry) => (
          <NewsCard
            image={entry.data.coverImage}
            imageAlt={entry.data.title}
            category={entry.data.category}
            date={formatNewsDate(entry.data.date)}
            title={entry.data.title}
            excerpt={entry.data.excerpt}
            href={`/news/${entry.id}`}
          />
        ))}
      </div>
      <div class="flex justify-center">
        <Button href="/news" variant="outline-forest" pad="px-[30px] py-4">View all news &amp; media</Button>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
