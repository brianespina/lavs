---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import Hero from "../../components/Hero.astro";
import ServiceSwitcher from "../../components/ServiceSwitcher.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import SlimCta from "../../components/SlimCta.astro";

/**
 * Catalog page, not a service-detail page — by client direction, this
 * replaces three separate pages (Coco Nets, Charcoal Briquettes, VCO Oil).
 * Each product is a photo + name + one line; no per-product detail page,
 * since every inquiry routes through the same /contact form. See
 * docs/decisions.md. Per-product SKU/packaging specifics aren't supplied
 * yet — see docs/open-items.md — so each card names what's confirmed on
 * inquiry rather than inventing figures.
 */
const products = [
  {
    image: "/images/products/coco-nets-geotextile.webp",
    alt: "Roll of woven coconut-fibre geotextile netting",
    name: "Coco Nets / Geotextile",
    body: "Erosion-control geotextiles woven from Philippine coconut fibre — a nature-based alternative for slope stabilisation.",
  },
  {
    image: "/images/products/coir-rope-twine.webp",
    alt: "Bundle of twisted coir rope",
    name: "Coir Rope & Twine",
    body: "Rope and twine spun from coconut husk fibre, for agricultural, marine, and handicraft use.",
  },
  {
    image: "/images/products/coconut-fiber.webp",
    alt: "Loose golden coconut husk fibre",
    name: "Coconut Fibre (Coir)",
    body: "Loose husk fibre supplied as feedstock for nets, rope, and moulded coir products.",
  },
  {
    image: "/images/products/coco-peat.webp",
    alt: "Pile of coco peat growing medium",
    name: "Coco Peat",
    body: "Coir pith growing medium — a renewable substitute for peat in nurseries and soil blends.",
  },
  {
    image: "/images/products/briquettes-hexagonal.webp",
    alt: "Hexagonal coconut-shell charcoal briquettes",
    name: "Hexagonal Charcoal Briquettes",
    body: "Hexagonal coconut-shell briquettes with a centre bore, for grilling and industrial heat.",
  },
  {
    image: "/images/products/briquettes-pillow.webp",
    alt: "Pillow-shaped coconut charcoal briquettes",
    name: "Pillow Charcoal Briquettes",
    body: "Pillow-form coconut-shell briquettes, the common shape for barbecue and household fuel.",
  },
  {
    image: "/images/products/briquettes-cylindrical.webp",
    alt: "Stacked cylindrical coconut-shell briquettes",
    name: "Cylindrical Charcoal Briquettes",
    body: "Cylindrical coconut-shell briquettes with a centre bore, supplied to bulk and export buyers.",
  },
  {
    image: "/images/products/shisha-charcoal.webp",
    alt: "Cube-cut coconut-shell shisha charcoal",
    name: "Shisha / Hookah Charcoal",
    body: "Cube-cut coconut-shell charcoal produced for the shisha and hookah market.",
  },
  {
    image: "/images/products/virgin-coconut-oil.webp",
    alt: "Virgin coconut oil poured over a fresh coconut",
    name: "Virgin Coconut Oil (VCO)",
    body: "Virgin coconut oil sourced through our producer network for commercial, industrial, and export buyers.",
  },
  {
    image: "/images/products/coconut-shell.webp",
    alt: "Two halves of a dried coconut shell",
    name: "Coconut Shell",
    body: "Whole and split shell, supplied as feedstock for charcoal and activated carbon production.",
  },
  {
    image: "/images/products/smoked-copra.webp",
    alt: "Smoke-dried copra",
    name: "Smoked Copra",
    body: "Smoke-dried copra from Quezon Province farms, supplied to oil millers and processors.",
  },
];
---

<BaseLayout title="Philippine Bulk Agro-Industrial Supplies">
  <div class="overflow-hidden bg-white">
    <SiteNav active="lavs" />

    <Hero
      image="/images/products/hero-coconut-byproducts.webp"
      imageAlt="Smoke-dried copra, one of the Philippine coconut byproducts supplied at volume"
      breadcrumb={{ parentLabel: "LAVS Trading & Development", parentHref: "/lavs-trading", current: "Bulk Agro-Industrial Supplies" }}
      title="Philippine bulk agro-industrial supplies"
      lead="Durable, eco-friendly Philippine agricultural byproducts — coco nets, charcoal briquettes, VCO oil, and raw agro-industrial materials — supplied at industrial volume to commercial and global markets."
    />

    <ServiceSwitcher active="bulk-agro-industrial-supplies" />

    <!-- Product catalog -->
    <div class="band-x flex flex-col gap-10 bg-white py-14 lg:gap-12 lg:py-20">
      <div class="flex flex-col items-start gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-[14px]">
          <SectionLabel text="What we supply" color="text-muted" />
          <div class="text-[28px] font-semibold leading-[1.16] tracking-[-.025em] text-forest lg:text-[34px]">Bulk commodities, one inquiry</div>
        </div>
        <div class="max-w-[380px] text-pretty text-[14.5px] leading-[1.6] text-muted">
          Product name, grade, packaging, and volume are confirmed against your requirement — send an inquiry and we'll come back with specifics.
        </div>
      </div>

      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-4">
        {products.map((p) => (
          <a
            href="/contact"
            class="group flex flex-col overflow-hidden rounded-tl-panel-lg rounded-br-panel-lg border border-border-light bg-white hover:border-forest"
          >
            <div class="relative h-[170px] overflow-hidden rounded-tl-panel rounded-br-panel">
              <img src={p.image} alt={p.alt} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col gap-[10px] p-6">
              <div class="text-pretty text-lg font-semibold leading-[1.25] text-forest">{p.name}</div>
              <div class="text-pretty text-[13.5px] leading-[1.55] text-body">{p.body}</div>
              <div class="mt-auto pt-2 text-[11px] font-semibold uppercase tracking-[.14em] text-gold group-hover:text-gold-light">Inquire &rarr;</div>
            </div>
          </a>
        ))}
      </div>
    </div>

    <SlimCta
      question="Need Philippine bulk commodities at volume?"
      subline="Tell us the product, grade, and volume you need."
      ctaLabel="Inquire about commercial supply"
      ctaHref="/contact"
    />

    <SiteFooter />
  </div>
</BaseLayout>
