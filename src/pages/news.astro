---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import NewsCard from "../components/NewsCard.astro";
import { NEWS_CATEGORIES, formatNewsDate } from "../lib/news";

const allNews = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const byCategory = (category: (typeof NEWS_CATEGORIES)[number]) =>
  allNews.filter((entry) => entry.data.category === category);

const lavsAll = byCategory("LAVS Trading");
const lavsFeature = lavsAll.find((entry) => entry.data.featured) ?? lavsAll[0];
const lavsThumbs = lavsAll.filter((entry) => entry.id !== lavsFeature?.id).slice(0, 3);

const cortijoCards = byCategory("Cortijo").slice(0, 3);

const sustAll = byCategory("Sustainability & Community");
const sustFeature = sustAll.find((entry) => entry.data.featured) ?? sustAll[0];

const filters = ["All", ...NEWS_CATEGORIES] as const;
---

<BaseLayout title="News & Media">
  <div class="overflow-hidden bg-white">
    <SiteNav active="news" />

    <Hero
      image="/images/pexels-oktay-koseoglu-42034955-38040480.jpg"
      imageAlt="LAVS and Cortijo ecosystem"
      eyebrow="News & media"
      title="Latest news & ecosystem updates"
      lead="Commercial milestones, TESDA graduations, accreditation updates, and community programmes from across the ecosystem."
    />

    <!-- Filter strip -->
    <div class="band-x flex h-auto flex-wrap items-stretch bg-forest-deep lg:h-16 lg:flex-nowrap">
      {filters.map((f, i) => (
        <button
          type="button"
          data-filter={f}
          aria-pressed={i === 0 ? "true" : "false"}
          class={
            i === 0
              ? "flex items-center whitespace-nowrap rounded-tl-field rounded-br-field bg-gold-light px-6 py-3 text-[12.5px] font-semibold uppercase tracking-[.06em] text-ink lg:py-0"
              : "flex items-center whitespace-nowrap px-6 py-3 text-[12.5px] font-medium uppercase tracking-[.06em] text-mint hover:text-gold-light lg:py-0"
          }
        >
          {f}
        </button>
      ))}
    </div>

    <div class="band-x flex flex-col gap-14 bg-white py-14 pb-16 lg:gap-[72px] lg:py-[72px] lg:pb-[88px]">
      <!-- LAVS updates -->
      <div data-section="LAVS Trading" class="flex flex-col gap-7 lg:gap-8">
        <div class="flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:gap-5">
          <div class="whitespace-nowrap text-2xl font-semibold tracking-[-.02em] text-forest lg:text-[26px]">LAVS Trading updates</div>
          <div class="hidden h-px flex-1 bg-border-light lg:block"></div>
          <div class="whitespace-nowrap text-xs font-semibold uppercase tracking-[.14em] text-muted">
            Commercial milestones &middot; industrial supply &middot; landscape development
          </div>
        </div>

        {lavsFeature && (
          <div class="flex flex-col gap-8 lg:flex-row">
            <a href={`/news/${lavsFeature.id}`} class="flex flex-[1.6] flex-col">
              <div class="relative h-[240px] overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[340px]">
                <img src={lavsFeature.data.coverImage} alt={lavsFeature.data.title} class="h-full w-full object-cover" loading="lazy" />
              </div>
              <div class="flex flex-col gap-[14px] pt-7">
                <div class="flex items-center gap-3">
                  <div class="bg-forest px-[10px] py-[6px] text-[10px] font-semibold uppercase tracking-[.14em] text-bone">LAVS Trading</div>
                  <div class="text-xs text-muted">{formatNewsDate(lavsFeature.data.date)}</div>
                </div>
                <div class="text-pretty text-2xl font-semibold leading-[1.24] tracking-[-.02em] text-forest lg:text-[28px]">
                  {lavsFeature.data.title}
                </div>
                <div class="max-w-[620px] text-pretty text-[15px] leading-[1.65] text-body">
                  {lavsFeature.data.excerpt}
                </div>
                <div class="text-xs font-semibold uppercase tracking-[.1em] text-gold">Read more &rarr;</div>
              </div>
            </a>

            <div class="flex flex-1 flex-col gap-6">
              {lavsThumbs.map((entry, i) => (
                <a href={`/news/${entry.id}`} class={`flex gap-5 ${i < lavsThumbs.length - 1 ? "border-b border-border-light pb-6" : ""}`}>
                  <div class="h-[100px] w-[130px] flex-none overflow-hidden rounded-tl-chip rounded-br-chip">
                    <img src={entry.data.coverImage} alt="" class="h-full w-full object-cover" loading="lazy" />
                  </div>
                  <div class="flex flex-col gap-2">
                    <div class="text-[11px] uppercase tracking-[.12em] text-muted">{formatNewsDate(entry.data.date)}</div>
                    <div class="text-pretty text-[16.5px] font-semibold leading-[1.3] text-forest">{entry.data.title}</div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Cortijo milestones -->
      <div data-section="Cortijo" class="flex flex-col gap-7 lg:gap-8">
        <div class="flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:gap-5">
          <div class="whitespace-nowrap text-2xl font-semibold tracking-[-.02em] text-forest lg:text-[26px]">Cortijo de Palsabangon milestones</div>
          <div class="hidden h-px flex-1 bg-border-light lg:block"></div>
          <div class="whitespace-nowrap text-xs font-semibold uppercase tracking-[.14em] text-muted">
            TESDA graduations &middot; DA-ATI updates &middot; outreach &middot; awards
          </div>
        </div>
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {cortijoCards.map((entry) => (
            <NewsCard
              image={entry.data.coverImage}
              imageAlt={entry.data.title}
              category={entry.data.category}
              date={formatNewsDate(entry.data.date)}
              title={entry.data.title}
              excerpt={entry.data.excerpt}
              href={`/news/${entry.id}`}
            />
          ))}
        </div>
      </div>

      <!-- Sustainability feature -->
      {sustFeature && (
        <div data-section="Sustainability & Community" class="flex flex-col items-start gap-8 rounded-tl-panel rounded-br-panel bg-sand p-7 lg:flex-row lg:items-center lg:gap-11 lg:p-11">
          <a href={`/news/${sustFeature.id}`} class="relative h-[200px] w-full flex-none overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[200px] lg:w-[300px]">
            <img src={sustFeature.data.coverImage} alt={sustFeature.data.title} class="h-full w-full object-cover" loading="lazy" />
          </a>
          <div class="flex flex-col gap-[14px]">
            <div class="flex items-center gap-3">
              <div class="bg-gold px-[10px] py-[6px] text-[10px] font-semibold uppercase tracking-[.14em] text-ink">Sustainability &amp; community</div>
              <div class="text-xs text-clay">{formatNewsDate(sustFeature.data.date)}</div>
            </div>
            <a href={`/news/${sustFeature.id}`} class="max-w-[660px] text-pretty text-2xl font-semibold leading-[1.24] tracking-[-.02em] text-forest hover:text-forest-mid lg:text-[26px]">
              {sustFeature.data.title}
            </a>
            <div class="max-w-[660px] text-pretty text-[14.5px] leading-[1.65] text-clay-deep">
              {sustFeature.data.excerpt}
            </div>
            <a href={`/news/${sustFeature.id}`} class="text-xs font-semibold uppercase tracking-[.1em] text-forest hover:text-gold">Read more &rarr;</a>
          </div>
        </div>
      )}

      <div class="flex justify-center">
        <Button href="/news" variant="outline-forest" pad="px-[30px] py-4">Load more updates</Button>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const sections = document.querySelectorAll<HTMLElement>("[data-section]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.filter;

      buttons.forEach((b) => {
        const active = b === button;
        b.setAttribute("aria-pressed", String(active));
        b.classList.toggle("bg-gold-light", active);
        b.classList.toggle("text-ink", active);
        b.classList.toggle("rounded-tl-field", active);
        b.classList.toggle("rounded-br-field", active);
        b.classList.toggle("text-mint", !active);
        b.classList.toggle("hover:text-gold-light", !active);
      });

      sections.forEach((section) => {
        const show = filter === "All" || section.dataset.section === filter;
        section.classList.toggle("hidden", !show);
      });
    });
  });
</script>
