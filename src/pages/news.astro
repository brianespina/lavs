---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import Button from "../components/Button.astro";
import NewsCard from "../components/NewsCard.astro";

const lavsThumbs = [
  { date: "July 2026", title: "Hardscape landscaping completed for a mixed-use development", image: "/images/pexels-daniel-agundiz-2159069831-36866669.jpg" },
  { date: "June 2026", title: "VCO oil supply agreement signed with an industrial buyer", image: "/images/pexels-yeye-159057926-37342497.jpg" },
  { date: "May 2026", title: "Farm development project breaks ground on a 3-hectare property", image: "/images/pexels-andromeda99-36102634.jpg" },
];

const cortijoMilestones = [
  {
    image: "/images/pexels-th-tieu-707737703-33729068.jpg",
    imageAlt: "TESDA graduation",
    category: "Cortijo" as const,
    date: "July 2026",
    title: "New batch completes Organic Agriculture Production NCII",
    excerpt: "Farmers and students certified at the farm school and assessment center.",
    href: "/news",
  },
  {
    image: "/images/pexels-kenzero14-22610719.jpg",
    imageAlt: "Coconut learning site",
    category: "Cortijo" as const,
    date: "April 2026",
    title: "Recognized as a specialized Coconut Learning Site",
    excerpt: "A new DA-ATI designation adds coconut-specific programs to the farm school.",
    href: "/news",
  },
  {
    image: "/images/pexels-armandoh2-18749480.jpg",
    imageAlt: "Senior High School immersion students",
    category: "Cortijo" as const,
    date: "March 2026",
    title: "Senior High School immersion partnership welcomes a new cohort",
    excerpt: "Students join the working farm for hands-on technical training.",
    href: "/news",
  },
];

// Filter behavior is an explicit open item in the handoff (not yet
// designed/wired) — rendered as a static, visually-active "All" state.
const filters = ["All", "LAVS Trading", "Cortijo", "Sustainability"];
---

<BaseLayout title="News & Media">
  <div class="overflow-hidden bg-white">
    <SiteNav active="news" />

    <Hero
      image="/images/pexels-oktay-koseoglu-42034955-38040480.jpg"
      imageAlt="LAVS and Cortijo ecosystem"
      eyebrow="News & media"
      title="Latest news & ecosystem updates"
      lead="Commercial milestones, TESDA graduations, accreditation updates, and community programmes from across the ecosystem."
    />

    <!-- Filter strip -->
    <div class="band-x flex h-auto flex-wrap items-stretch bg-forest-deep lg:h-16 lg:flex-nowrap">
      {filters.map((f, i) => (
        <div
          class={
            i === 0
              ? "flex items-center whitespace-nowrap rounded-tl-field rounded-br-field bg-gold-light px-6 py-3 text-[12.5px] font-semibold uppercase tracking-[.06em] text-ink lg:py-0"
              : "flex items-center whitespace-nowrap px-6 py-3 text-[12.5px] font-medium uppercase tracking-[.06em] text-mint lg:py-0"
          }
        >
          {f}
        </div>
      ))}
    </div>

    <div class="band-x flex flex-col gap-14 bg-white py-14 pb-16 lg:gap-[72px] lg:py-[72px] lg:pb-[88px]">
      <!-- LAVS updates -->
      <div class="flex flex-col gap-7 lg:gap-8">
        <div class="flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:gap-5">
          <div class="whitespace-nowrap text-2xl font-semibold tracking-[-.02em] text-forest lg:text-[26px]">LAVS Trading updates</div>
          <div class="hidden h-px flex-1 bg-border-light lg:block"></div>
          <div class="whitespace-nowrap text-xs font-semibold uppercase tracking-[.14em] text-muted">
            Commercial milestones &middot; industrial supply &middot; landscape development
          </div>
        </div>

        <div class="flex flex-col gap-8 lg:flex-row">
          <a href="/news" class="flex flex-[1.6] flex-col">
            <div class="relative h-[240px] overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[340px]">
              <img src="/images/pexels-safari-consoler-3290243-36073761.jpg" alt="Commercial milestone" class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex flex-col gap-[14px] pt-7">
              <div class="flex items-center gap-3">
                <div class="bg-forest px-[10px] py-[6px] text-[10px] font-semibold uppercase tracking-[.14em] text-bone">LAVS Trading</div>
                <div class="text-xs text-muted">August 2026</div>
              </div>
              <div class="text-pretty text-2xl font-semibold leading-[1.24] tracking-[-.02em] text-forest lg:text-[28px]">
                Bulk commodity distribution expands to a new cooperative partner network
              </div>
              <div class="max-w-[620px] text-pretty text-[15px] leading-[1.65] text-body">
                A recent milestone in coco net and activated carbon supply for large-scale environmental projects, opening a new channel for producers in Quezon Province.
              </div>
              <div class="text-xs font-semibold uppercase tracking-[.1em] text-gold">Read more &rarr;</div>
            </div>
          </a>

          <div class="flex flex-1 flex-col gap-6">
            {lavsThumbs.map((t, i) => (
              <a href="/news" class={`flex gap-5 ${i < lavsThumbs.length - 1 ? "border-b border-border-light pb-6" : ""}`}>
                <div class="h-[100px] w-[130px] flex-none overflow-hidden rounded-tl-chip rounded-br-chip">
                  <img src={t.image} alt="" class="h-full w-full object-cover" loading="lazy" />
                </div>
                <div class="flex flex-col gap-2">
                  <div class="text-[11px] uppercase tracking-[.12em] text-muted">{t.date}</div>
                  <div class="text-pretty text-[16.5px] font-semibold leading-[1.3] text-forest">{t.title}</div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Cortijo milestones -->
      <div class="flex flex-col gap-7 lg:gap-8">
        <div class="flex flex-col items-start gap-3 lg:flex-row lg:items-center lg:gap-5">
          <div class="whitespace-nowrap text-2xl font-semibold tracking-[-.02em] text-forest lg:text-[26px]">Cortijo de Palsabangon milestones</div>
          <div class="hidden h-px flex-1 bg-border-light lg:block"></div>
          <div class="whitespace-nowrap text-xs font-semibold uppercase tracking-[.14em] text-muted">
            TESDA graduations &middot; DA-ATI updates &middot; outreach &middot; awards
          </div>
        </div>
        <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
          {cortijoMilestones.map((m) => <NewsCard {...m} />)}
        </div>
      </div>

      <!-- Sustainability feature -->
      <div class="flex flex-col items-start gap-8 rounded-tl-panel rounded-br-panel bg-sand p-7 lg:flex-row lg:items-center lg:gap-11 lg:p-11">
        <div class="relative h-[200px] w-full flex-none overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[200px] lg:w-[300px]">
          <img src="/images/pexels-railgunbreaker-37438024.jpg" alt="Joint environmental initiative" class="h-full w-full object-cover" loading="lazy" />
        </div>
        <div class="flex flex-col gap-[14px]">
          <div class="flex items-center gap-3">
            <div class="bg-gold px-[10px] py-[6px] text-[10px] font-semibold uppercase tracking-[.14em] text-ink">Sustainability &amp; community</div>
            <div class="text-xs text-[#7A6438]">June 2026</div>
          </div>
          <div class="max-w-[660px] text-pretty text-2xl font-semibold leading-[1.24] tracking-[-.02em] text-forest lg:text-[26px]">
            Joint erosion-control initiative brings hardscaping expertise to local watersheds
          </div>
          <div class="max-w-[660px] text-pretty text-[14.5px] leading-[1.65] text-[#4A4132]">
            A shared LAVS and Cortijo program pairing community outreach with nature-based materials &mdash; coco nets, geotextiles, and replanting led by trained local growers.
          </div>
          <div class="text-xs font-semibold uppercase tracking-[.1em] text-forest">Read more &rarr;</div>
        </div>
      </div>

      <div class="flex justify-center">
        <Button href="/news" variant="outline-forest" pad="px-[30px] py-4">Load more updates</Button>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
