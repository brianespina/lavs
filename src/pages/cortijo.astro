---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import Hero from "../components/Hero.astro";
import SectionLabel from "../components/SectionLabel.astro";
import SlimCta from "../components/SlimCta.astro";

const offers = [
  {
    image: "/images/pexels-roman-odintsov-12719333.jpg",
    alt: "TESDA class in session",
    title: "TESDA training programs",
    body: "Organic Agriculture Production NCII, Animal Production, and Modernized High-Quality Inbred Rice Production using advanced machinery.",
    cta: "View programs →",
  },
  {
    image: "/images/pexels-alfomedeiros-11573787.jpg",
    alt: "Nursery, seedlings and agricultural inputs",
    title: "Agricultural inputs, seedlings & nurseries",
    body: "Farm produce, inputs, and nursery stock from a working 5.2-hectare farm, supplied to growers and cooperatives.",
    cta: "See what's available →",
  },
  {
    image: "/images/pexels-armandoh2-18749480.jpg",
    alt: "Assessment and certification session",
    title: "Micro-credential training",
    body: "Short-form technical credentials and national certification across multiple qualifications, assessed on site.",
    cta: "Enroll now →",
  },
];

const stats = [
  { value: "2012", label: "Established" },
  { value: "5.2 ha", label: "Working farm" },
  { value: "2015", label: "DA-ATI learning site" },
];

const credentials = [
  {
    badge: "DA-ATI",
    since: "Since 2015",
    title: "Accredited Learning Site & Coconut LSA",
    body: "An official Learning Site in Agriculture since 2015, and a specialized Coconut Learning Site since 2025.",
  },
  {
    badge: "TESDA",
    since: "Farm school",
    title: "Accredited Farm School",
    body: "Teaching critical agricultural competencies — Organic Agriculture Production NCII, Animal Production (hogs, poultry, small ruminants), and Modernized High-Quality Inbred Rice Production.",
  },
  {
    badge: "TESDA",
    since: "Assessment center",
    title: "Accredited Assessment Center",
    body: "Officially authorized to conduct national certifications across OAP NCII, AGE NCII/NCIII, ACP NCII, and LIM NCII.",
  },
  {
    badge: "DepEd",
    since: "JDVP partner",
    title: "Joint Delivery Partner School",
    body: "An official Joint Delivery Voucher Program partner institution and Senior High School immersion partner farm, providing specialized tech-voc training.",
  },
];

const callouts = [
  { border: "border-gold", title: "Award-winning leadership", body: "Honored by regional agricultural bodies and recognized for championship-level Rural Improvement Club community leadership." },
  { border: "border-olive", title: "Academic immersion & OJT partner", body: "A trusted institutional training ground, welcoming OJT students, interns, and student researchers from colleges, high schools, and universities across the Philippines." },
];

const whoHelp = [
  { title: "For agricultural producers & cooperatives", body: "We bridge the gap between dedicated local producers and the broader market. By taking on the burden of marketing and distribution, we ensure that high-quality Philippine agricultural goods reach the right buyers at fair prices — turning hard work into sustainable success." },
  { title: "For aspiring farmers & students", body: "Through Cortijo de Palsabangon Farm OPC and our community agriculture courses, we empower individuals with practical, hands-on knowledge, technical training, and certified skills to build sustainable farming careers." },
];
---

<BaseLayout title="Cortijo de Palsabangon Farm">
  <div class="overflow-hidden bg-white">
    <SiteNav active="cortijo" />

    <Hero
      image="/images/pexels-azinuddin-bin-abas-76503503-15717701.jpg"
      imageAlt="Farm landscape and training session at Cortijo de Palsabangon"
      eyebrow="Cortijo de Palsabangon Farm OPC · Est. 2012"
      title="Agricultural education, training & community leadership"
      lead="A DA-ATI Accredited Learning Site and TESDA Registered Farm School and Assessment Center, equipping farmers, students, and agricultural partners with national-standard competencies."
    />

    <!-- What we offer -->
    <div class="band-x flex flex-col gap-11 bg-bone py-14 lg:py-20">
      <div class="flex flex-col gap-[14px]">
        <SectionLabel text="What we offer" color="text-muted" />
        <div class="text-[32px] font-semibold leading-[1.14] tracking-[-.025em] text-forest lg:text-[40px]">Training, inputs, and produce</div>
      </div>
      <div class="grid grid-cols-1 gap-7 sm:grid-cols-2 lg:grid-cols-3">
        {offers.map((o) => (
          <div class="flex flex-col overflow-hidden rounded-tl-panel-lg rounded-br-panel-lg bg-white">
            <div class="relative h-[180px] overflow-hidden rounded-tl-panel rounded-br-panel lg:h-[210px]">
              <img src={o.image} alt={o.alt} class="h-full w-full object-cover" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col gap-4 p-7 lg:p-8">
              <div class="text-xl font-semibold leading-[1.25] text-forest">{o.title}</div>
              <div class="text-pretty text-[14.5px] leading-[1.65] text-body">{o.body}</div>
              <div class="mt-auto pt-1 text-xs font-semibold uppercase tracking-[.1em] text-olive">{o.cta}</div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Who we are -->
    <div class="band-x flex flex-col gap-10 bg-white py-16 lg:flex-row lg:gap-16 lg:py-[88px]">
      <div class="flex flex-1 flex-col gap-6">
        <SectionLabel text="Who we are" color="text-muted" />
        <div class="text-pretty text-[28px] font-semibold leading-[1.18] tracking-[-.025em] text-forest lg:text-[36px]">
          The most valuable crop we can cultivate is knowledge.
        </div>
        <div class="text-pretty text-[15.5px] leading-[1.7] text-body">
          Cortijo de Palsabangon Farm has been rooted in the belief that sharing knowledge is the most powerful catalyst for uplifting our community. Established in 2012, our 5.2-hectare farm has served as an open classroom for Quezon Province and beyond.
        </div>
        <div class="text-pretty text-[15.5px] leading-[1.7] text-body">
          Whether we are teaching modern organic methods to veteran farmers or giving students their very first taste of hands-on agriculture, our mission is simple: to build a future where Filipino farmers stand proud, skilled, and deeply equipped to feed the nation.
        </div>
        <div class="flex gap-9 pt-3">
          {stats.map((s) => (
            <div class="flex flex-col gap-[5px]">
              <div class="text-[32px] font-bold leading-none tracking-[-.02em] text-olive lg:text-[38px]">{s.value}</div>
              <div class="text-xs font-medium uppercase tracking-[.14em] text-muted">{s.label}</div>
            </div>
          ))}
        </div>
      </div>
      <div class="relative min-h-[280px] flex-1 overflow-hidden rounded-tl-panel rounded-br-panel lg:min-h-[440px]">
        <img src="/images/pexels-nc-farm-bureau-mark-8658558.jpg" alt="Farm open classroom" class="h-full w-full object-cover" loading="lazy" />
      </div>
    </div>

    <!-- Credentials & accreditations -->
    <div class="band-x flex flex-col gap-10 bg-forest py-16 lg:gap-12 lg:py-[88px]">
      <div class="flex flex-col items-start gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="flex flex-col gap-[14px]">
          <SectionLabel text="Credentials & accreditations" color="text-sage" />
          <div class="text-[32px] font-semibold leading-[1.14] tracking-[-.025em] text-bone lg:text-[40px]">Recognized, authorized, accredited</div>
        </div>
        <div class="max-w-[400px] text-pretty text-[15px] leading-[1.65] text-pale-sage">
          TESDA micro-credentials, technical training, and industry licenses &mdash; verified with national bodies.
        </div>
      </div>

      <div class="grid grid-cols-1 gap-[2px] bg-bone/[.16] sm:grid-cols-2">
        {credentials.map((c) => (
          <div class="flex flex-col gap-[14px] bg-forest p-7 lg:p-[34px]">
            <div class="flex items-center gap-3">
              <div class="bg-gold-light px-[10px] py-[6px] text-[10px] font-bold uppercase tracking-[.14em] text-ink">{c.badge}</div>
              <div class="text-[11px] uppercase tracking-[.14em] text-sage">{c.since}</div>
            </div>
            <div class="text-xl font-semibold leading-[1.3] text-bone">{c.title}</div>
            <div class="text-pretty text-[14.5px] leading-[1.65] text-mint">{c.body}</div>
          </div>
        ))}
      </div>

      <div class="grid grid-cols-1 gap-8 pt-2 sm:grid-cols-2">
        {callouts.map((c) => (
          <div class={`flex flex-col gap-3 border-l-[3px] ${c.border} pl-6`}>
            <div class="text-lg font-semibold text-bone">{c.title}</div>
            <div class="text-pretty text-[14.5px] leading-[1.65] text-pale-sage">{c.body}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Who we help -->
    <div class="band-x flex flex-col gap-11 bg-white py-16 lg:py-[88px]">
      <div class="flex flex-col gap-[14px]">
        <SectionLabel text="Who we help" color="text-muted" />
        <div class="text-[32px] font-semibold leading-[1.14] tracking-[-.025em] text-forest lg:text-[40px]">Producers, cooperatives, and students</div>
      </div>
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        {whoHelp.map((w) => (
          <div class="flex flex-col gap-4 rounded-tl-panel rounded-br-panel bg-bone p-8 lg:p-[38px]">
            <div class="text-pretty text-xl font-semibold leading-[1.25] text-forest lg:text-[23px]">{w.title}</div>
            <div class="text-pretty text-[15px] leading-[1.68] text-body">{w.body}</div>
          </div>
        ))}
      </div>
    </div>

    <SlimCta
      question="Ready to train, get certified, or source from the farm?"
      subline="Enrollment and supply inquiries go to the same team."
      ctaLabel="Enroll in TESDA courses"
      ctaHref="/contact"
    />

    <SiteFooter />
  </div>
</BaseLayout>
