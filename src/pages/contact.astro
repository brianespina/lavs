---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";

const topics = [
  "Commercial supply",
  "Landscaping / site development",
  "Farm development",
  "TESDA enrollment",
  "Farm produce & inputs",
  "Partnership",
  "Something else",
];

const fieldClass =
  "rounded-tl-field rounded-br-field border border-border-light-2 bg-white px-4 py-[14px] text-sm text-forest placeholder:text-placeholder focus:border-forest focus:outline-none";
const labelClass = "text-[11.5px] font-semibold uppercase tracking-[.14em] text-body";
---

<BaseLayout title="Contact">
  <div class="overflow-hidden bg-white">
    <SiteNav active="contact" />

    <!-- Contact is the one page with a flat band instead of a photo hero -->
    <div class="band-x flex flex-col items-start gap-8 bg-forest py-14 lg:flex-row lg:items-end lg:justify-between lg:gap-16 lg:py-[72px]">
      <div class="flex flex-col gap-5">
        <SectionLabel text="Contact us" color="text-sage" />
        <div class="max-w-[680px] text-pretty text-[36px] font-semibold leading-[1.08] tracking-[-.03em] text-bone lg:text-[52px]">
          Tell us what you need
        </div>
      </div>
      <div class="max-w-[420px] text-pretty text-base leading-[1.65] text-mint">
        Commercial supply, land development, farm produce, or TESDA enrollment &mdash; one team answers all of it.
      </div>
    </div>

    <div class="band-x flex flex-col gap-10 bg-white py-14 lg:flex-row lg:items-start lg:gap-14 lg:py-20">
      <!-- Form: not yet wired to a backend — see /docs/open-items.md -->
      <form class="flex flex-[1.3] flex-col gap-7 bg-bone p-7 lg:p-11">
        <div class="text-2xl font-semibold leading-[1.25] tracking-[-.02em] text-forest">Send an inquiry</div>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <div class="flex flex-col gap-[9px]">
            <label class={labelClass} for="name">Full name *</label>
            <input class={fieldClass} type="text" id="name" name="name" placeholder="Juan dela Cruz" required />
          </div>
          <div class="flex flex-col gap-[9px]">
            <label class={labelClass} for="company">Company / organization</label>
            <input class={fieldClass} type="text" id="company" name="company" placeholder="Optional" />
          </div>
          <div class="flex flex-col gap-[9px]">
            <label class={labelClass} for="email">Email *</label>
            <input class={fieldClass} type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="flex flex-col gap-[9px]">
            <label class={labelClass} for="mobile">Mobile number *</label>
            <input class={fieldClass} type="tel" id="mobile" name="mobile" placeholder="09XX XXX XXXX" required />
          </div>
        </div>

        <fieldset class="flex flex-col gap-[11px]">
          <legend class={labelClass}>What is this about? *</legend>
          <div class="flex flex-wrap gap-[9px]">
            {topics.map((topic, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="topic" value={topic} class="peer sr-only" checked={i === 0} required />
                <span class="inline-block whitespace-nowrap rounded-tl-chip rounded-br-chip border border-border-light-2 px-[15px] py-[10px] text-[12.5px] font-medium text-forest peer-checked:border-forest peer-checked:bg-forest peer-checked:text-bone peer-focus-visible:ring-2 peer-focus-visible:ring-forest">
                  {topic}
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <div class="flex flex-col gap-[9px]">
          <label class={labelClass} for="message">Message *</label>
          <textarea
            class={`${fieldClass} h-[118px] resize-none leading-[1.6]`}
            id="message"
            name="message"
            placeholder="Volumes, timelines, location, or the course you're interested in — the more specific, the faster we can answer."
            required
          ></textarea>
        </div>

        <div class="flex flex-col items-start gap-4 pt-1 sm:flex-row sm:items-center sm:justify-between">
          <div class="max-w-[300px] text-pretty text-xs leading-[1.6] text-muted">
            We reply within one business day. Your details are used only to answer your inquiry.
          </div>
          <Button type="submit" variant="gold" pad="px-[30px] py-[17px]" class="flex-none">Send inquiry</Button>
        </div>
      </form>

      <div class="flex flex-1 flex-col gap-6">
        <div class="flex flex-col gap-[26px] rounded-tl-panel rounded-br-panel bg-forest p-7 lg:p-9">
          <div class="text-[11.5px] font-semibold uppercase tracking-[.2em] text-gold-light">Direct lines</div>
          <div class="flex flex-col gap-5">
            <div class="flex flex-col gap-[6px]">
              <div class="text-[11px] uppercase tracking-[.14em] text-sage">Mobile</div>
              <div class="text-xl font-semibold leading-[1.4] text-bone">0917 143 1060<br />0915 009 0383</div>
            </div>
            <div class="flex flex-col gap-[6px]">
              <div class="text-[11px] uppercase tracking-[.14em] text-sage">Email</div>
              <div class="text-[17px] font-medium text-bone">lavstradecorp@gmail.com</div>
            </div>
            <div class="flex flex-col gap-[10px]">
              <div class="text-[11px] uppercase tracking-[.14em] text-sage">Social</div>
              <div class="flex gap-[9px]">
                {["f", "ig", "in", "g"].map((label) => (
                  <div class="flex h-9 w-9 cursor-pointer items-center justify-center border border-pale-sage/40 text-xs font-semibold text-mint hover:border-gold-light hover:text-gold-light">
                    {label}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="flex flex-col gap-[18px] rounded-tl-panel rounded-br-panel border border-border-light p-7">
          <div class="text-[11.5px] font-semibold uppercase tracking-[.2em] text-muted">Two enterprises, one inbox</div>
          <div class="flex flex-col gap-[14px]">
            <div class="flex items-start gap-[13px]">
              <div class="mt-[6px] h-2 w-2 flex-none bg-forest"></div>
              <div class="text-pretty text-sm leading-[1.6] text-body">
                <strong class="font-semibold text-forest">LAVS Trading &amp; Development Services Inc.</strong> &mdash; commercial supply, land development, hardscaping.
              </div>
            </div>
            <div class="flex items-start gap-[13px]">
              <div class="mt-[6px] h-2 w-2 flex-none bg-olive"></div>
              <div class="text-pretty text-sm leading-[1.6] text-body">
                <strong class="font-semibold text-forest">Cortijo de Palsabangon Farm OPC</strong> &mdash; training, certification, produce and inputs. Quezon Province.
              </div>
            </div>
          </div>
        </div>

        <div class="relative h-[240px] overflow-hidden rounded-tl-panel rounded-br-panel">
          <img src="/images/pexels-quang-nguyen-vinh-222549-14024972.jpg" alt="Farm location" class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>

    <SiteFooter />
  </div>
</BaseLayout>
