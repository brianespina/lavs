---
/**
 * The "Plot Grid" brand mark — four parcels in a 2x2 grid, top-left and
 * bottom-right struck with a radius (same diagonal-pair logic as the
 * corner system). Ship as inline SVG, never a raster.
 */
interface Props {
  size?: number;
  /** "cortijo" renders the mark in Cortijo's palette for its group-attribution
   * role on Cortijo surfaces — see docs/design-system.md#cortijo-brand-system.
   * It is still the LAVS Plot Grid mark, just recolored. */
  variant?: "dark" | "light" | "cortijo";
  class?: string;
}

const { size = 46, variant = "dark", class: className } = Astro.props;

const fillsByVariant = {
  dark: { a: "fill-bone", b: "fill-sage", c: "fill-bone", d: "fill-gold-light" },
  light: { a: "fill-forest", b: "fill-olive", c: "fill-forest", d: "fill-gold" },
  cortijo: { a: "fill-cortijo-bone", b: "fill-cortijo-sage", c: "fill-cortijo-bone", d: "fill-cortijo-clay" },
} as const;

const fills = fillsByVariant[variant];
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  class={["flex-none", className].filter(Boolean).join(" ")}
  aria-hidden="true"
>
  <path d="M0 0 H45 A45 45 0 0 1 0 45 Z" class={fills.a}></path>
  <rect x="51" y="0" width="45" height="45" class={fills.b}></rect>
  <rect x="0" y="51" width="45" height="45" class={fills.c}></rect>
  <path d="M96 96 V51 A45 45 0 0 0 51 96 Z" class={fills.d}></path>
</svg>
