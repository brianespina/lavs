---
interface Props {
  image: string;
  imageAlt: string;
  category: "LAVS Trading" | "Cortijo" | "Sustainability";
  date: string;
  title: string;
  excerpt: string;
  href: string;
}

const { image, imageAlt, category, date, title, excerpt, href } = Astro.props;

const badgeColor: Record<Props["category"], string> = {
  "LAVS Trading": "bg-forest text-bone",
  Cortijo: "bg-olive text-white",
  Sustainability: "bg-gold text-ink",
};
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-tl-panel-lg rounded-br-panel-lg bg-bone hover:bg-bone-deep"
>
  <div class="h-[230px] overflow-hidden">
    <img src={image} alt={imageAlt} class="h-full w-full object-cover" loading="lazy" />
  </div>
  <div class="flex flex-1 flex-col gap-[14px] p-[30px]">
    <div class="flex items-center gap-3">
      <div class={`px-[10px] py-[6px] text-[10px] font-semibold uppercase tracking-[.14em] ${badgeColor[category]}`}>
        {category}
      </div>
      <div class="text-xs text-muted">{date}</div>
    </div>
    <div class="text-pretty text-xl font-semibold leading-[1.3] text-forest">{title}</div>
    <div class="text-pretty text-sm leading-[1.6] text-body">{excerpt}</div>
    <div class="mt-auto pt-2 text-xs font-semibold uppercase tracking-[.1em] text-gold">Read more &rarr;</div>
  </div>
</a>
