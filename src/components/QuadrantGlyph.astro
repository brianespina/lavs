---
/**
 * Miniature of the logo used before every section eyebrow. Monochrome —
 * inherits color via currentColor. Two opposite quadrants full opacity,
 * two at .45.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 13, class: className } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 96 96"
  class={["flex-none", className].filter(Boolean).join(" ")}
  aria-hidden="true"
>
  <path d="M0 0 H45 A45 45 0 0 1 0 45 Z" fill="currentColor"></path>
  <rect x="51" y="0" width="45" height="45" fill="currentColor" opacity=".45"></rect>
  <rect x="0" y="51" width="45" height="45" fill="currentColor" opacity=".45"></rect>
  <path d="M96 96 V51 A45 45 0 0 0 51 96 Z" fill="currentColor"></path>
</svg>
