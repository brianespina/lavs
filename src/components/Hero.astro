---
import SectionLabel from "./SectionLabel.astro";

/**
 * Standard interior hero: 440px, photo background at .68 forest overlay,
 * eyebrow (or breadcrumb) + headline + lead. Used on every interior page
 * except Contact, which is a flat band instead (see ContactHero pattern
 * inline on that page).
 */
interface Breadcrumb {
  parentLabel: string;
  parentHref: string;
  current: string;
}

interface Props {
  image: string;
  imageAlt: string;
  title: string;
  lead: string;
  eyebrow?: string;
  breadcrumb?: Breadcrumb;
}

const { image, imageAlt, title, lead, eyebrow, breadcrumb } = Astro.props;
---

<div class="relative h-[320px] bg-forest lg:h-[440px]">
  <div class="absolute inset-0">
    <img src={image} alt={imageAlt} class="h-full w-full object-cover" />
  </div>
  <div class="absolute inset-0 bg-forest opacity-[.68]"></div>
  <div class="band-x pointer-events-none absolute inset-0 flex flex-col justify-center gap-4 py-10 lg:gap-[22px]">
    {
      breadcrumb ? (
        <div class="pointer-events-auto flex items-center gap-[10px] text-[11.5px] font-semibold uppercase tracking-[.16em]">
          <a href={breadcrumb.parentHref} class="text-sage hover:text-gold-light">
            {breadcrumb.parentLabel}
          </a>
          <span class="text-[#4E6B45]">/</span>
          <span class="text-gold-light">{breadcrumb.current}</span>
        </div>
      ) : (
        eyebrow && <SectionLabel text={eyebrow} color="text-sage" />
      )
    }
    <div class="text-pretty text-[34px] font-semibold leading-[1.1] tracking-[-.03em] text-bone lg:max-w-[820px] lg:text-[52px] lg:leading-[1.08]">
      {title}
    </div>
    <div class="text-pretty text-[15px] leading-[1.6] text-mint lg:max-w-[680px] lg:text-[17.5px]">
      {lead}
    </div>
  </div>
</div>
